{
  "version": 1,
  "_comment": "Single source of truth for genre normalization. Loaded by server.py at startup and by lib.js in the browser (precached by the service worker). OpenLibrary subjects are messy free text; each rule maps substrings to a display genre, and the top few by hit count win.",
  "_note": "Matching is punctuation-insensitive: entries are folded to lowercase words, so 'sci-fi' also matches 'Sci Fi'. Rules are ordered specific-before-general; the first matching rule wins per subject and ties break toward the earlier rule.",
  "exclude": [
    "accessible book", "protected daisy", "in library", "internet archive",
    "large type books", "overdrive", "open library", "reading level",
    "nyt:", "new york times", "lending library", "popular print",
    "award", "long now manual", "book club", "staff picks", "reviewed"
  ],
  "rules": [
    { "genre": "Fantasy", "match": ["fantasy", "magic", "wizard", "dragon", "sword and sorcery", "mythical", "elves"] },
    { "genre": "Science Fiction", "match": ["science fiction", "sciencefiction", "sci-fi", "space opera", "dystopia", "cyberpunk", "time travel", "extraterrestrial", "robots", "space flight"] },
    { "genre": "Mystery", "match": ["mystery", "detective", "whodunit", "crime fiction", "murder", "noir"] },
    { "genre": "Thriller", "match": ["thriller", "suspense", "espionage", "spy stories"] },
    { "genre": "Horror", "match": ["horror", "ghost", "vampire", "supernatural", "haunted", "zombie"] },
    { "genre": "Romance", "match": ["romance", "love stories", "romantic"] },
    { "genre": "Historical Fiction", "match": ["historical fiction", "historical novel"] },
    { "genre": "Literary Fiction", "match": ["literary", "literature", "classic", "fiction, general", "domestic fiction"] },
    { "genre": "Young Adult", "match": ["young adult", "teenage", "coming of age", "juvenile fiction"] },
    { "genre": "Children's", "match": ["children", "picture book", "juvenile literature", "toy and movable"] },
    { "genre": "Comics", "match": ["comic", "graphic novel", "manga", "cartoons"] },
    { "genre": "Poetry", "match": ["poetry", "poems", "verse"] },
    { "genre": "Drama", "match": ["drama", "plays", "theater", "tragedy"] },
    { "genre": "Biography", "match": ["biography", "autobiography", "memoir", "personal narrative"] },
    { "genre": "History", "match": ["history", "historic", "civilization", "war", "ancient"] },
    { "genre": "Science", "match": ["science", "physics", "biology", "astronomy", "evolution", "mathematics", "chemistry"] },
    { "genre": "Technology", "match": ["computer", "programming", "software", "engineering", "technology", "internet"] },
    { "genre": "Philosophy", "match": ["philosophy", "ethics", "metaphysics", "logic"] },
    { "genre": "Psychology", "match": ["psychology", "mental health", "cognitive", "consciousness"] },
    { "genre": "Self-Help", "match": ["self-help", "self help", "personal growth", "productivity", "habits", "motivation"] },
    { "genre": "Business", "match": ["business", "economics", "management", "entrepreneur", "finance", "marketing"] },
    { "genre": "Politics", "match": ["political", "politics", "government", "democracy", "public policy"] },
    { "genre": "Religion", "match": ["religion", "christian", "bible", "buddhis", "islam", "spiritual", "theology"] },
    { "genre": "Travel", "match": ["travel", "voyages", "description and travel", "guidebook"] },
    { "genre": "Cooking", "match": ["cooking", "cookbook", "recipes", "food writing"] },
    { "genre": "Art", "match": ["art", "painting", "photography", "architecture", "design", "music"] },
    { "genre": "Nature", "match": ["nature", "natural history", "environment", "ecology", "animals", "gardening"] },
    { "genre": "Health", "match": ["health", "fitness", "medicine", "nutrition", "diet"] },
    { "genre": "Sports", "match": ["sports", "baseball", "football", "basketball", "athletics", "olympic"] },
    { "genre": "Adventure", "match": ["adventure", "survival", "seafaring", "western stories"] },
    { "genre": "Humor", "match": ["humor", "humour", "satire", "comedy", "wit"] },
    { "genre": "True Crime", "match": ["true crime", "criminals", "serial murder"] },
    { "genre": "Essays", "match": ["essays", "collected works", "criticism"] }
  ]
}
